create_clock -name clk -period 20.0 [get_ports {clk}]
create_generated_clock -name clk_dp -source [get_ports {clk}] -multiply_by 11 -divide_by 5 [get_pins {u_pll/CLKOUT0}]
create_generated_clock -name clk_nrv -source [get_ports {clk}] -multiply_by 5 -divide_by 5 [get_pins {u_pll/CLKOUT1}]
create_clock -name lan_rgmii_rx_clk -period 8.0 [get_ports {lan_rgmii_rx_clk}]
create_clock -name wan_rgmii_rx_clk -period 8.0 [get_ports {wan_rgmii_rx_clk}]
set_clock_groups -asynchronous -group [get_clocks {clk}] -group [get_clocks {clk_dp}] -group [get_clocks {clk_nrv}] -group [get_clocks {lan_rgmii_rx_clk wan_rgmii_rx_clk}]

set_input_delay -clock lan_rgmii_rx_clk -max 2.0 [get_ports {lan_rgmii_rxd[0] lan_rgmii_rxd[1] lan_rgmii_rxd[2] lan_rgmii_rxd[3] lan_rgmii_rx_ctl}]
set_input_delay -clock lan_rgmii_rx_clk -min 1.5 [get_ports {lan_rgmii_rxd[0] lan_rgmii_rxd[1] lan_rgmii_rxd[2] lan_rgmii_rxd[3] lan_rgmii_rx_ctl}]
set_input_delay -clock wan_rgmii_rx_clk -max 2.0 [get_ports {wan_rgmii_rxd[0] wan_rgmii_rxd[1] wan_rgmii_rxd[2] wan_rgmii_rxd[3] wan_rgmii_rx_ctl}]
set_input_delay -clock wan_rgmii_rx_clk -min 1.5 [get_ports {wan_rgmii_rxd[0] wan_rgmii_rxd[1] wan_rgmii_rxd[2] wan_rgmii_rxd[3] wan_rgmii_rx_ctl}]
create_generated_clock -name lan_rgmii_tx_clk -source [get_pins {u_pll/CLKOUT0}] -divide_by 1 [get_ports {lan_rgmii_tx_clk}]
create_generated_clock -name wan_rgmii_tx_clk -source [get_pins {u_pll/CLKOUT0}] -divide_by 1 [get_ports {wan_rgmii_tx_clk}]
set_output_delay -clock lan_rgmii_tx_clk -max 1.0 -min 0.5 [get_ports {lan_rgmii_txd[0] lan_rgmii_txd[1] lan_rgmii_txd[2] lan_rgmii_txd[3] lan_rgmii_tx_ctl}]
set_output_delay -clock wan_rgmii_tx_clk -max 1.0 -min 0.5 [get_ports {wan_rgmii_txd[0] wan_rgmii_txd[1] wan_rgmii_txd[2] wan_rgmii_txd[3] wan_rgmii_tx_ctl}]
