// Clock (Bank 5, VCCIO5 = 3.3V)
IO_LOC "clk" E2;
IO_PORT "clk" IO_TYPE=LVCMOS33;

// Reset (Bank 7, VCCIO6/7 = 3.3V)
IO_LOC "rst_n" H11;
IO_PORT "rst_n" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// LAN RGMII RX (Bank 2, VCCIO2 = 1.8V)
