IO_LOC "wan_rgmii_txd[3]" G8;
IO_PORT "wan_rgmii_txd[3]" IO_TYPE=LVCMOS18;

// SPI (Bank 7, VCCIO6/7 = 3.3V)
IO_LOC "spi_sck" K7;
IO_PORT "spi_sck" IO_TYPE=LVCMOS33;
IO_LOC "spi_mosi" K6;
IO_PORT "spi_mosi" IO_TYPE=LVCMOS33;
IO_LOC "spi_miso" J7;
IO_PORT "spi_miso" IO_TYPE=LVCMOS33;
IO_LOC "spi_csn" L6;
IO_PORT "spi_csn" IO_TYPE=LVCMOS33 PULL_MODE=UP;
