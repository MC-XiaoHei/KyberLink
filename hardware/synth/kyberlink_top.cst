// Clock (Bank 5, VCCIO5 = 3.3V)
IO_LOC "clk" E2;
IO_PORT "clk" IO_TYPE=LVCMOS33;

// Reset (Bank 7, VCCIO6/7 = 3.3V)
IO_LOC "rst_n" H11;
IO_PORT "rst_n" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// LAN RGMII RX (Bank 2, VCCIO2 = 1.8V)
IO_LOC "lan_rgmii_rx_clk" L4;
IO_PORT "lan_rgmii_rx_clk" IO_TYPE=LVCMOS18;
IO_LOC "lan_rgmii_rx_ctl" J4;
IO_PORT "lan_rgmii_rx_ctl" IO_TYPE=LVCMOS18;
IO_LOC "lan_rgmii_rxd[0]" L2;
IO_PORT "lan_rgmii_rxd[0]" IO_TYPE=LVCMOS18;
IO_LOC "lan_rgmii_rxd[1]" L1;
IO_PORT "lan_rgmii_rxd[1]" IO_TYPE=LVCMOS18;
IO_LOC "lan_rgmii_rxd[2]" K1;
IO_PORT "lan_rgmii_rxd[2]" IO_TYPE=LVCMOS18;
IO_LOC "lan_rgmii_rxd[3]" K2;
IO_PORT "lan_rgmii_rxd[3]" IO_TYPE=LVCMOS18;

// LAN RGMII TX (Bank 2, VCCIO2 = 1.8V)
IO_LOC "lan_rgmii_tx_clk" J1;
IO_PORT "lan_rgmii_tx_clk" IO_TYPE=LVCMOS18;
IO_LOC "lan_rgmii_tx_ctl" J2;
IO_PORT "lan_rgmii_tx_ctl" IO_TYPE=LVCMOS18;
IO_LOC "lan_rgmii_txd[0]" K4;
IO_PORT "lan_rgmii_txd[0]" IO_TYPE=LVCMOS18;
IO_LOC "lan_rgmii_txd[1]" G2;
IO_PORT "lan_rgmii_txd[1]" IO_TYPE=LVCMOS18;
IO_LOC "lan_rgmii_txd[2]" G1;
IO_PORT "lan_rgmii_txd[2]" IO_TYPE=LVCMOS18;
IO_LOC "lan_rgmii_txd[3]" L3;
IO_PORT "lan_rgmii_txd[3]" IO_TYPE=LVCMOS18;

// WAN RGMII RX (Bank 0, VCCIO0 = 1.8V)
IO_LOC "wan_rgmii_rx_clk" J8;
IO_PORT "wan_rgmii_rx_clk" IO_TYPE=LVCMOS18;
IO_LOC "wan_rgmii_rx_ctl" K8;
IO_PORT "wan_rgmii_rx_ctl" IO_TYPE=LVCMOS18;
IO_LOC "wan_rgmii_rxd[0]" F7;
IO_PORT "wan_rgmii_rxd[0]" IO_TYPE=LVCMOS18;
IO_LOC "wan_rgmii_rxd[1]" F6;
IO_PORT "wan_rgmii_rxd[1]" IO_TYPE=LVCMOS18;
IO_LOC "wan_rgmii_rxd[2]" L9;
IO_PORT "wan_rgmii_rxd[2]" IO_TYPE=LVCMOS18;
IO_LOC "wan_rgmii_rxd[3]" K9;
IO_PORT "wan_rgmii_rxd[3]" IO_TYPE=LVCMOS18;

// WAN RGMII TX (Bank 1, VCCIO1 = 1.8V)
IO_LOC "wan_rgmii_tx_clk" H5;
IO_PORT "wan_rgmii_tx_clk" IO_TYPE=LVCMOS18;
IO_LOC "wan_rgmii_tx_ctl" F5;
IO_PORT "wan_rgmii_tx_ctl" IO_TYPE=LVCMOS18;
IO_LOC "wan_rgmii_txd[0]" H8;
IO_PORT "wan_rgmii_txd[0]" IO_TYPE=LVCMOS18;
IO_LOC "wan_rgmii_txd[1]" H7;
IO_PORT "wan_rgmii_txd[1]" IO_TYPE=LVCMOS18;
